{
  "name": "n8n-nodes-thinker",
  "version": "0.1.0",
  "description": "Use Thinker's OpenAI-compatible model router from n8n workflows.",
  "license": "MIT",
  "homepage": "https://github.com/patrickbrandao/thinker/tree/main/integrations/n8n-nodes-thinker#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "thinker",
    "ai",
    "llm",
    "openai-compatible",
    "model-router"
  ],
  "author": {
    "name": "Thinker contributors",
    "email": "patrickbrandao@users.noreply.github.com",
    "url": "https://github.com/patrickbrandao/thinker"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickbrandao/thinker.git",
    "directory": "integrations/n8n-nodes-thinker"
  },
  "bugs": {
    "url": "https://github.com/patrickbrandao/thinker/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "test": "npm run build && node --test",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "aiNodeSdkVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ThinkerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Thinker/Thinker.node.js",
      "dist/nodes/LmChatThinker/LmChatThinker.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/ai-node-sdk": "^0.34.4",
    "@n8n/node-cli": "^0.53.4",
    "eslint": "9.32.0",
    "n8n-workflow": "^2.44.2",
    "prettier": "3.6.2",
    "release-it": "^21.0.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "@n8n/ai-node-sdk": "*",
    "n8n-workflow": "*"
  }
}
