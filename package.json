{
  "name": "thinker",
  "private": true,
  "description": "Open-source LLM gateway for AI agents — route each request to the right model and track cost, tokens and full request logs",
  "homepage": "https://github.com/patrickbrandao/thinker",
  "repository": {
    "type": "git",
    "url": "https://github.com/patrickbrandao/thinker"
  },
  "bugs": {
    "url": "https://github.com/patrickbrandao/thinker/issues"
  },
  "author": "Patrick Brandão and Thinker contributors",
  "license": "MIT",
  "keywords": [
    "llm-gateway",
    "llm-router",
    "ai-agent",
    "llm-proxy",
    "openai-compatible",
    "anthropic-compatible",
    "self-hosted",
    "cost-tracking",
    "token-tracking",
    "nestjs",
    "solidjs"
  ],
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/shared",
    "packages/frontend",
    "packages/backend",
    "packages/thinker",
    "packages/cli"
  ],
  "scripts": {
    "dev": "turbo dev --filter=thinker-frontend",
    "build": "turbo build",
    "test": "turbo test",
    "start": "node packages/backend/dist/main.js",
    "design:registry": "node design-system/generate-registry.mjs",
    "design:registry:check": "node design-system/generate-registry.mjs --check",
    "test:scripts": "node --test scripts/*.test.js",
    "lint": "eslint packages/shared/src packages/backend/src packages/backend/test packages/backend/scripts packages/frontend/src packages/cli/src",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx,css}'",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/*/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/*/src/**/*.css": [
      "prettier --write"
    ]
  },
  "overrides": {
    "lodash": "^4.18.0",
    "nanoid": "^3.3.19",
    "defu": "^6.1.5",
    "picomatch": "^4.0.4",
    "path-to-regexp": "^8.4.1",
    "multer": "^2.4.0",
    "read-yaml-file": {
      "js-yaml": "3.15.2"
    },
    "undici@^6": "^6.28.1",
    "form-data": "^4.0.6",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "ajv": "8.20.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2"
  }
}
