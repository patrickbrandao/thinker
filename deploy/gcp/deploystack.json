{
  "title": "Thinker",
  "description": "Deploy Thinker on Google Cloud Run with Cloud SQL and durable Cloud Storage request recordings.",
  "logo": "https://raw.githubusercontent.com/patrickbrandao/thinker/main/.github/assets/thinker-logo.svg",
  "duration": 15,
  "documentationLink": "https://github.com/patrickbrandao/thinker/tree/main/deploy/gcp",
  "variables": [
    {
      "name": "project_id",
      "prompt": "Google Cloud project ID",
      "type": "project"
    },
    {
      "name": "region",
      "prompt": "Region",
      "type": "string",
      "default": "us-central1"
    },
    {
      "name": "service_name",
      "prompt": "Cloud Run service name",
      "type": "string",
      "default": "thinker"
    },
    {
      "name": "image_url",
      "prompt": "Thinker image",
      "type": "string",
      "default": "docker.io/tmsoftbrasil/thinker:0.1"
    },
    {
      "name": "database_tier",
      "prompt": "Cloud SQL machine tier",
      "type": "string",
      "default": "db-f1-micro"
    },
    {
      "name": "max_instances",
      "prompt": "Maximum Cloud Run instances",
      "type": "number",
      "default": 1
    },
    {
      "name": "database_deletion_protection",
      "prompt": "Enable Cloud SQL deletion protection",
      "type": "boolean",
      "default": true
    }
  ]
}
