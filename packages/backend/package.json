{
  "name": "thinker-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -f tsconfig.build.tsbuildinfo && nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
    "test:watch": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --watch",
    "test:e2e": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:docker": "node scripts/test-e2e-docker.mjs",
    "lint": "eslint src/ test/ scripts/",
    "typecheck": "tsc -p tsconfig.test.json",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/datasource.ts",
    "migration:run": "ts-node -T src/database/migrate.ts",
    "migration:run:prod": "node dist/database/migrate.js",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/datasource.ts --transaction none",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/datasource.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "backfill:message-providers": "ts-node -T src/database/backfills/backfill-message-providers.cli.ts",
    "backfill:message-providers:prod": "node dist/database/backfills/backfill-message-providers.cli.js",
    "backfill:requests": "ts-node -T src/database/backfills/request-backfill.cli.ts",
    "backfill:requests:prod": "node dist/database/backfills/request-backfill.cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@better-auth/cimd": "1.7.13",
    "@better-auth/mcp": "1.7.13",
    "@better-auth/oauth-provider": "1.7.13",
    "@modelcontextprotocol/server": "2.3.1",
    "@nestjs/cache-manager": "^12.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.4",
    "better-auth": "1.7.13",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "eventsource-parser": "^4.1.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "modelparams": "^0.0.72",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "thinker-shared": "*",
    "typeorm": "^0.3.0",
    "undici": "6.29.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "jest-environment-node": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!main.ts",
      "!**/database/migrations/**",
      "!**/database/datasource.ts",
      "!**/database/data-source-definitions.ts",
      "!**/database/migrate.ts",
      "!**/*.module.ts",
      "!**/otlp/interfaces/index.ts",
      "!**/otlp/proto/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/../test/support/unit-env.ts"
    ]
  }
}
