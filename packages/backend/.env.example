# ── Core (required) ──────────────────────────────────
BETTER_AUTH_SECRET=          # Min 32 chars. Generate with: openssl rand -hex 32
DATABASE_URL=                # PostgreSQL connection string: postgresql://user:password@host:port/database

# ── At-rest encryption (required) ────────────────────
# Encrypts stored LLM provider API keys, OAuth tokens and request recordings
# (the AES-256-GCM key is derived from this value via scrypt). Required: the
# server refuses to start when it is missing, shorter than 32 chars, or equal
# to BETTER_AUTH_SECRET. Changing it makes older recordings unreadable.
THINKER_ENCRYPTION_KEY=      # Min 32 chars, different from BETTER_AUTH_SECRET. Generate with: openssl rand -hex 32
# THINKER_ENCRYPTION_KEY_PREVIOUS=    # Rotation only: the old key (min 32 chars); rows are rewritten after boot while set, remove once the log reports nothing left
#                                     # Stored request recordings are not rewritten: after a key change they become unreadable and retention removes them


# ── Server ───────────────────────────────────────────
PORT=3001
BIND_ADDRESS=127.0.0.1       # Use 0.0.0.0 for Docker/Railway
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
# BETTER_AUTH_ALLOWED_HOSTS= # Extra hosts that may serve the dashboard/API (comma-separated). The OAuth callback and session cookie follow the request host, so set this when the same service answers on more than one domain (production only; BETTER_AUTH_URL and CORS_ORIGIN are always allowed). Wildcards like *.example.com work.
# FRONTEND_PORT=             # Extra trusted origin port for Better Auth
# THINKER_CORS_ORIGINS=      # Extra browser origins allowed to call the gateway (comma-separated). None by default: the dashboard is same-origin.
# THINKER_CIMD_ALLOW_PRIVATE=false # Set true to let MCP clients whose Client ID Metadata Document URL resolves to a private or loopback address sign in. Off by default: that URL comes from an unauthenticated client (SSRF). Cloud metadata endpoints stay blocked either way.
# MCP_ENABLED=               # Set false to run without the remote MCP server (/api/v1/mcp) and its OAuth endpoints. MCP needs an HTTPS BETTER_AUTH_URL (loopback HTTP is fine in dev); a plain-HTTP LAN or tailnet origin turns it off by itself and says so at boot, so set this only to acknowledge that or to switch MCP off on an install that could serve it.

# ── Database ─────────────────────────────────────────
# DB_POOL_MAX=10             # PostgreSQL connection pool size (default: 10)
# MIGRATION_DATABASE_URL=    # Direct (non-PgBouncer) URL for migrations and the standalone request-backfill worker
# BACKFILL_DATABASE_URL=     # Optional direct override for the standalone request-backfill worker
# AGENT_USAGE_DAILY_WORKER=true          # Set false to pause the asynchronous rollup worker
# AGENT_USAGE_DAILY_READS=               # Automatic by default; true forces rollups, false forces raw queries
# AGENT_USAGE_DAILY_READ_TENANTS=        # Optional comma-separated tenant rollout before global cutover
# AGENT_USAGE_DAILY_BATCH_SIZE=250       # Requests and provider attempts selected per transaction
# AGENT_USAGE_DAILY_RUN_BUDGET_MS=5000   # Maximum work budget for each one-minute run
# Optional recording retention override, in days (default 365).
# REQUEST_RECORDING_RETENTION_DAYS=365
# Storage selection defaults to auto: complete S3 credentials win; otherwise
# self-hosted installs use the mounted filesystem path. Managed Cloud never
# falls back to ephemeral local storage.
# REQUEST_RECORDING_STORAGE=auto       # auto | s3 | filesystem | disabled
# REQUEST_RECORDING_FILESYSTEM_PATH=/data/request-recordings
# REQUEST_RECORDING_S3_BUCKET=
# REQUEST_RECORDING_S3_ENDPOINT=
# REQUEST_RECORDING_S3_REGION=auto
# REQUEST_RECORDING_S3_ACCESS_KEY_ID=
# REQUEST_RECORDING_S3_SECRET_ACCESS_KEY=
# REQUEST_RECORDING_S3_FORCE_PATH_STYLE=false

# ── Public model catalogs (ADR 0003) ─────────────────
# THINKER_CATALOG_SYNC=true  # Set false to stop the only outbound calls Thinker makes on its own: openrouter.ai and models.dev (boot + daily) and the OpenCode Go doc on raw.githubusercontent.com (only with an OpenCode Go provider). Costs then come from the bundled data only; most models show $0.

# ── Rate Limiting ────────────────────────────────────
# THROTTLE_TTL=60000         # Rate limit window in ms (default: 60000)
# THROTTLE_LIMIT=100         # Max requests per window (default: 100)

# ── API Key (optional) ──────────────────────────────
# API_KEY=                   # Secret for programmatic access via X-API-Key header
# CLI_TOKEN_TTL_DAYS=30      # Sliding TTL in days for CLI-minted tokens (default: 30)
# CLI_TOKEN_ABSOLUTE_TTL_DAYS=90  # Hard ceiling in days from issuance — sliding never outlives it (default: 90)

# ── LLM Proxy ────────────────────────────────────────
# Per-attempt timeout (ms) for upstream provider requests in the LLM proxy.
# Set strictly below your client's timeout so the fallback chain has room to run.
# PROVIDER_TIMEOUT_MS=180000
# Timeout (ms) to wait for the first chunk from a streaming response before
# considering it stalled and trying a fallback provider.
# STREAM_WARMUP_MS=15000
# Maximum silence between upstream streaming events before failing with HTTP 504.
# STREAM_IDLE_TIMEOUT_MS=180000
# Timeout (ms) to wait for deliverable text or tool output from ChatGPT Codex.
# CODEX_SEMANTIC_OUTPUT_TIMEOUT_MS=60000
# Per-tenant concurrent in-flight request limit for each backend process.
# THINKER_CONCURRENCY_MAX=10
# Per-tenant (M201) and per-IP (M202) requests/minute for each backend process.
# THINKER_RATE_MAX_REQUESTS=200
# THINKER_IP_RATE_MAX_REQUESTS=500

# ── Email provider (optional, unified) ──────────────
# Used for BOTH Better Auth transactional emails (login verification,
# password reset) and threshold alert notifications when no per-user
# config exists. Set ONE provider block below.
#
# Without any email provider: signup verification waived, password reset
# no-ops. Threshold alerts still work if users configure their own provider
# in the dashboard Notifications → Email Provider.

# Option A: Resend (recommended — no domain setup required)
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_your_api_key_here
# EMAIL_FROM=noreply@yourdomain.com

# Option B: Mailgun
# EMAIL_PROVIDER=mailgun
# EMAIL_API_KEY=key-your_api_key_here
# EMAIL_DOMAIN=mg.yourdomain.com
# EMAIL_FROM=noreply@mg.yourdomain.com

# Option C: SendGrid
# EMAIL_PROVIDER=sendgrid
# EMAIL_API_KEY=SG.your_api_key_here
# EMAIL_FROM=noreply@yourdomain.com

# ── Legacy Mailgun (deprecated, use EMAIL_* instead) ─
# Still honored for backward compat with older deployments.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# NOTIFICATION_FROM_EMAIL=noreply@manifest.build

# ── OAuth Providers (all optional) ──────────────────
# Each provider activates only when both CLIENT_ID and CLIENT_SECRET are set.
# Callback URL pattern: {BETTER_AUTH_URL}/api/auth/callback/{provider}

# Google: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Discord: https://discord.com/developers/applications
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ── Plugin ──────────────────────────────────────────
# PLUGIN_OTLP_ENDPOINT=       # Custom OTLP endpoint for the plugin

# ── Data Seeding ────────────────────────────────────
# SEED_DATA=true              # Seed demo data + admin user on startup (self-hosted first boot)

# ── Internal ────────────────────────────────────────
# THINKER_FRONTEND_DIR=      # Custom path to frontend dist directory
# THINKER_EMBEDDED=          # Set to skip auto-start (used by embedded server)
