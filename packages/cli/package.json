{
  "name": "thinker-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Thinker gateway management CLI (thinker): configure agents, providers, and routing from the terminal",
  "license": "MIT",
  "homepage": "https://github.com/patrickbrandao/thinker/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickbrandao/thinker.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/patrickbrandao/thinker/issues"
  },
  "keywords": [
    "thinker",
    "llm",
    "gateway",
    "router",
    "cli",
    "ai-agents",
    "openai-compatible"
  ],
  "bin": {
    "thinker": "bin/thinker.js"
  },
  "main": "dist/index.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && npm run gen && tsc6 -p tsconfig.build.json",
    "typecheck": "tsc6 -p tsconfig.json --noEmit",
    "typecheck:ts7": "node ../../scripts/tsgo.mjs -p tsconfig.json --noEmit",
    "test": "jest",
    "gen": "node scripts/generate-provider-catalog.cjs && node scripts/generate-skill-content.cjs",
    "set-version": "node scripts/set-version.cjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "^30.5.1",
    "prettier": "^3.9.10",
    "thinker-shared": "*",
    "ts-jest": "^29.4.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
