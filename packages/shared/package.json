{
  "name": "thinker-shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc6 -p tsconfig.cjs.json && tsc6 -p tsconfig.esm.json",
    "typecheck": "tsc6 -p tsconfig.json --noEmit && tsc6 -p tsconfig.test.json",
    "typecheck:ts7": "node ../../scripts/tsgo.mjs -p tsconfig.json --noEmit && node ../../scripts/tsgo.mjs -p tsconfig.test.json --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
