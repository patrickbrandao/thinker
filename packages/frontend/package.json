{
  "name": "thinker-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run build --workspace=thinker-shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "pretypecheck": "npm run build --workspace=thinker-shared",
    "typecheck": "tsc6 -p tsconfig.json --noEmit",
    "pretypecheck:ts7": "npm run build --workspace=thinker-shared",
    "typecheck:ts7": "node ../../scripts/tsgo.mjs -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "better-auth": "1.7.13",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.0",
    "motion": "^14.6.0",
    "solid-js": "^1.9.17",
    "thinker-shared": "*",
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
