{
  "name": "thinker-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run build --workspace=thinker-shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ && node scripts/check-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "pretypecheck": "npm run build --workspace=thinker-shared",
    "typecheck": "tsc6 -p tsconfig.json --noEmit",
    "pretypecheck:ts7": "npm run build --workspace=thinker-shared",
    "typecheck:ts7": "node ../../scripts/tsgo.mjs -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "better-auth": "1.7.13",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.62.0",
    "marked": "^18.1.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "thinker-shared": "*",
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
