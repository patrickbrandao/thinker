{
  "permissions": {
    "deny": [
      "Bash(git *push * main)",
      "Bash(git *push * main *)",
      "Bash(git *push *:main)",
      "Bash(git *push *:main *)",
      "Bash(git *push *refs/heads/main)",
      "Bash(git *push *refs/heads/main *)",
      "Bash(git *push *--mirror*)",
      "Bash(git *push *--all*)",
      "Bash(git *push *--force*)",
      "Bash(git *push -f)",
      "Bash(git *push -f *)",
      "Bash(git *push * -f)",
      "Bash(git *push * -f *)",
      "Bash(git *push -uf *)",
      "Bash(git *push * -uf *)",
      "Bash(git *push -fu *)",
      "Bash(git *push * -fu *)",
      "Bash(git *push +*)",
      "Bash(git *push * +*)",
      "Bash(gh *merge*--admin*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *git/refs/heads/main*)",
      "Bash(gh api *branches/*/protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api graphql*mergePullRequest*)",
      "Bash(gh api graphql*BranchProtectionRule*)",
      "Bash(gh api graphql*Ruleset*)",
      "Bash(gh api graphql*updateRef*)",
      "Bash(gh api graphql*deleteRef*)"
    ],
    "ask": [
      "Bash(git *push *--tags*)",
      "Bash(git *push *--follow-tags*)",
      "Bash(git *push * v*)",
      "Bash(git *push *refs/tags/*)",
      "Bash(git *push * tag *)",
      "Bash(git *push *@*)",
      "Bash(gh release *)",
      "Bash(gh workflow run*)",
      "Bash(gh api *dispatches*)",
      "Bash(gh api *releases*)",
      "Bash(npm *publish*)",
      "Bash(docker *push*)",
      "Bash(*changeset publish*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; case \"$f\" in */packages/frontend/src/*.css|*/packages/frontend/src/*.tsx|*/packages/frontend/src/*.ts) d=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$d/scripts/check-design-tokens.mjs\" ] || exit 0; out=$(cd \"$d\" && node scripts/check-design-tokens.mjs 2>&1) || printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":%s}}' \"$(printf 'Design-token check after your edit (tokens only, see packages/frontend/src/styles/tokens.css):\\n%s' \"$out\" | head -c 4000 | jq -Rs .)\";; esac; }",
            "timeout": 30,
            "statusMessage": "Checking design tokens"
          }
        ]
      }
    ]
  }
}
