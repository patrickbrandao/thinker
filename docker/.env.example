# ─── Required ──────────────────────────────────────────────────────────────

# Session signing secret. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# ─── At-rest encryption (recommended) ──────────────────────────────────────
# Encrypts stored LLM provider API keys / OAuth tokens. If unset, falls back
# to BETTER_AUTH_SECRET — convenient, but a session-cookie leak then also
# decrypts every stored provider credential. Set to a SEPARATE 32+ char value
# so the two leak surfaces stay independent. Generate with: openssl rand -hex 32
# THINKER_ENCRYPTION_KEY=


# ─── Deployment URL + port ─────────────────────────────────────────────────

# App port. Default: 2099. This is the one knob for changing the port —
# the compose file reads ${PORT:-2099} for both the published host port and
# the backend's internal listener, and BETTER_AUTH_URL below defaults to
# http://localhost:${PORT:-2099}. No YAML edit needed.
#
# Also how existing installs upgrading from an older image stay on the
# previous port (PORT=3001), keeping reverse-proxy, OAuth callback, and
# bookmarked URLs working without a reconfiguration.
# PORT=8080

# Bind to every network interface only when the dashboard should be reachable
# beyond this machine. The default is loopback-only.
# HOST_BIND_ADDRESS=0.0.0.0

# Change only the host-side port while keeping Manifest's internal port at 2099.
# HOST_PORT=8080

# Override when deploying to a domain (e.g., https://manifest.example.com).
# Default: http://localhost:${HOST_PORT:-${PORT:-2099}}
# BETTER_AUTH_URL=http://localhost:2099

# Extra hosts that may serve the dashboard and API, comma-separated (e.g.,
# app.example.com,gateway.example.com). The OAuth callback and session cookie
# follow the request host, so set this when the same instance answers on more
# than one domain. BETTER_AUTH_URL and CORS_ORIGIN are always allowed.
# Wildcards like *.example.com are accepted.
# BETTER_AUTH_ALLOWED_HOSTS=
# MCP_ENABLED=false         # Run without the remote MCP server (/api/v1/mcp). MCP needs an HTTPS BETTER_AUTH_URL (the localhost default is fine too); a plain-HTTP LAN or tailnet address switches it off by itself.

# Pin upgrades to a release, major, or minor Docker tag. Default: latest.
# THINKER_VERSION=0.1


# ─── Database ──────────────────────────────────────────────────────────────

# To harden the bundled Postgres password, set BOTH of the variables below.
# They must agree. Special characters in the password must be percent-encoded
# in DATABASE_URL (e.g. `@` → `%40`, `:` → `%3A`, `/` → `%2F`).
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://manifest:change-me@postgres:5432/manifest


# ─── Request recordings ───────────────────────────────────────────────────

# Message recordings are stored automatically in the named Docker volume
# mounted at /data/request-recordings. Override retention globally if needed;
# otherwise self-hosted installations retain recordings for 365 days.
# REQUEST_RECORDING_RETENTION_DAYS=365

# Multi-replica and hosted installations should use S3-compatible storage.
# Complete S3 configuration takes precedence over the local Docker volume.
# REQUEST_RECORDING_STORAGE=auto
# REQUEST_RECORDING_S3_BUCKET=
# REQUEST_RECORDING_S3_ENDPOINT=
# REQUEST_RECORDING_S3_REGION=auto
# REQUEST_RECORDING_S3_ACCESS_KEY_ID=
# REQUEST_RECORDING_S3_SECRET_ACCESS_KEY=
# REQUEST_RECORDING_S3_FORCE_PATH_STYLE=false


# ─── LLM proxy ───────────────────────────────────────────────────────────────

# Per-attempt timeout (ms) for upstream provider requests in the LLM proxy.
# Set strictly below your client's timeout so the fallback chain has room to run.
# PROVIDER_TIMEOUT_MS=180000

# Timeout (ms) to wait for the first chunk from a streaming response before
# considering it stalled and trying a fallback provider.
# STREAM_WARMUP_MS=15000

# Timeout (ms) to wait for deliverable text or tool output from ChatGPT Codex.
# CODEX_SEMANTIC_OUTPUT_TIMEOUT_MS=60000

# Per-tenant concurrent in-flight request limit for each backend process.
# THINKER_CONCURRENCY_MAX=10

# ─── Email provider (optional) ─────────────────────────────────────────────
#
# Unified config — used for BOTH login emails (signup verification, password
# reset) AND threshold alert notifications. Set ONE provider block below.
#
# Without any email provider:
#   - Signup verification is waived (users created as unverified-but-usable)
#   - Password reset silently no-ops (use DB admin to reset)
#   - Threshold alerts still work if you configure per-user in the dashboard
#
# Per-user providers configured in the dashboard always take precedence over
# these server-wide defaults, so cloud multi-tenant setups can still use
# per-user config on top of a shared fallback.

# Option A: Resend (recommended for self-hosting — no domain setup required)
# Sign up at https://resend.com, create an API key, and set:
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_your_api_key_here
# EMAIL_FROM=noreply@yourdomain.com

# Option B: Mailgun (requires a verified sending domain)
# EMAIL_PROVIDER=mailgun
# EMAIL_API_KEY=key-your_api_key_here
# EMAIL_DOMAIN=mg.yourdomain.com
# EMAIL_FROM=noreply@mg.yourdomain.com

# Option C: SendGrid
# EMAIL_PROVIDER=sendgrid
# EMAIL_API_KEY=SG.your_api_key_here
# EMAIL_FROM=noreply@yourdomain.com


# ─── OAuth logins (optional) ───────────────────────────────────────────────
#
# Each provider activates automatically when both CLIENT_ID and CLIENT_SECRET
# are set. Configure callback URL to: ${BETTER_AUTH_URL}/api/auth/callback/<provider>

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=


# ─── Serving over plain HTTP ───────────────────────────────────────────────
#
# On boot Manifest warns when BETTER_AUTH_URL is not an https:// origin,
# because it can't send HSTS. Set this to 1 to silence the warning on an
# HTTP-only LAN deployment. Anywhere reachable from the internet, put a real
# https:// URL in BETTER_AUTH_URL instead of setting this.
# THINKER_DISABLE_HSTS=1


# ─── Rate limiting + database tuning (optional) ────────────────────────────

# Rate limit: max requests per window, and the window in ms.
# THROTTLE_LIMIT=100
# THROTTLE_TTL=60000

# Gateway guardrails on /v1 proxy traffic, per backend process. Defaults: 200
# requests/minute per tenant (M201), 500 requests/minute per IP (M202). The
# in-flight cap (M203) is THINKER_CONCURRENCY_MAX above. An invalid value
# falls back to the default.
# THINKER_RATE_MAX_REQUESTS=200
# THINKER_IP_RATE_MAX_REQUESTS=500

# PostgreSQL pool sizes. DB_POOL_MAX is the app's pool; Better Auth opens a
# second, smaller one of its own.
# DB_POOL_MAX=10
# AUTH_DB_POOL_MAX=5

# Set false for multi-replica deploys where only one instance should run
# migrations on boot. A single-container compose install wants the default.
# RUN_MIGRATIONS_ON_BOOT=true

# Daily agent usage is populated asynchronously. Reads switch to it
# automatically after the initial backfill catches up.
# Set false to pause the worker. It is enabled by default.
# AGENT_USAGE_DAILY_WORKER=true
# Optional override: true forces rollups immediately; false forces raw queries.
# AGENT_USAGE_DAILY_READS=false
# Optional comma-separated tenant IDs for a staged read rollout.
# AGENT_USAGE_DAILY_READ_TENANTS=
# Optional worker limits. Defaults: 250 rows per source and 5000 ms per run.
# AGENT_USAGE_DAILY_BATCH_SIZE=250
# AGENT_USAGE_DAILY_RUN_BUDGET_MS=5000


# ─── Browser access from other origins (optional) ──────────────────────────
#
# The dashboard is same-origin, so no other browser origin may call the
# gateway by default. List extra origins here (comma-separated) to allow a
# browser tool you run elsewhere.
# THINKER_CORS_ORIGINS=https://tools.example.internal


# ─── MCP clients on your LAN (optional) ─────────────────────────────────────
#
# An MCP client may identify itself with an HTTPS URL (a Client ID Metadata
# Document) that Thinker fetches during OAuth. Since that URL comes from an
# unauthenticated client, Thinker only fetches it from public addresses. Set
# true if you host MCP clients on a private or loopback address. Cloud
# metadata endpoints stay blocked either way. Custom providers on your LAN
# (Ollama, LM Studio, vLLM) are always allowed and do not need this.
# THINKER_CIMD_ALLOW_PRIVATE=false


# ─── Public model catalogs (ADR 0003) ──────────────────────────────────────
#
# The only outbound calls Thinker makes on its own, besides the providers you
# configure:
#   - openrouter.ai/api/v1/models and models.dev/api.json, at boot and once a
#     day, for model prices, context windows and capabilities;
#   - the OpenCode Go doc on raw.githubusercontent.com, only when an OpenCode
#     Go provider is registered, for its model list and per-request cost.
# Set false to turn all three off (air-gapped installs). Thinker then uses only
# the bundled data, which covers few models: most requests are recorded with no
# known price and show as $0, OpenCode Go requests cost $0, and the model
# picker shows no prices for most models.
# THINKER_CATALOG_SYNC=true
